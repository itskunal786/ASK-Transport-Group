export interface ClientBooking {
  id: number;
  bookingNumber: string;
  bookingStatus: string;
  paymentStatus: string;
  totalAmount: number;
  createdAt: string;
}

export interface ClientBookingData {
  page: number;
  pageSize: number;
  totalRecords: number;
  totalPages: number;
  data: ClientBooking[];
}

export interface ClientBookingResponse {
  success: boolean;
  message: string;
  data: ClientBookingData;
}
